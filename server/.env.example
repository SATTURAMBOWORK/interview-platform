# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/interviewprep

# JWT secret key (use a long random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-me

# AI API keys
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# Frontend URL for CORS (no trailing slash)
# Development: http://localhost:5173
# Production: https://your-app.vercel.app
# Multiple origins can be comma-separated
# Example: https://your-app.vercel.app,https://your-app-git-main-yourname.vercel.app
CLIENT_URL=http://localhost:5173

# C++ judge queue: runs at the same time (default 2) and max waiting (default 20)
JUDGE_CONCURRENCY=2
JUDGE_MAX_QUEUE=20
# Redis for the judge queue (BullMQ). Leave unset to use an in-memory queue.
# Local: redis://localhost:6379   Hosted: rediss://default:<password>@<host>:6379
REDIS_URL=
# Set to "off" on the API when a separate `npm run worker` process runs submissions
JUDGE_WORKER=

# Server port (default 5000)
PORT=5000
